# Server Environment Variables
# Copy this file to .env and fill in your actual values

# Database
MONGODB_URI=mongodb://localhost:27017/newbrend_furniture

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Paystack
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# Cloudflare R2 (S3-compatible storage)
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_access_key
R2_SECRET_KEY=your_secret_key
R2_BUCKET=your_bucket_name
R2_PUBLIC_BASE_URL=https://your_custom_domain.com

# Client URL
# Public website URL only. Do not use a Render API or /health-check URL here.
CLIENT_URL=http://localhost:5173

# Port
PORT=4000

# Environment
NODE_ENV=development

# Web Push Notifications (PWA)
# Generate VAPID keys with: npx web-push generate-vapid-keys
# Copy the output values here
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:info@resyinpublications.com

# Email (optional, for future email notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=info@resyinpublications.com
EMAIL_PASSWORD=your_app_password
